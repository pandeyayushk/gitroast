# Server-only GitHub App configuration. Never commit secret values.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=

# Hosted production: set the PEM contents here. Escaped newlines are supported.
GITHUB_PRIVATE_KEY=

# Local development: path to a gitignored PEM file, e.g. secrets/github-app.pem.
# Configure only one private-key source; GITHUB_PRIVATE_KEY takes precedence.
GITHUB_PRIVATE_KEY_PATH=

# Server-only Gemini configuration. Never expose this as a NEXT_PUBLIC_* variable.
GEMINI_API_KEY=
GEMINI_MODEL=
